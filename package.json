{
  "name": "dsh-tool-mssql",
  "version": "0.1.0",
  "description": "DeepSeek Harness SQL Server tool plugin — native mssql driver, multi-source, read-only by default, credentials stay host-side (no MCP server in between)",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run tests",
    "check": "npm run typecheck && npm test && npm run build",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.7 || ^0.1.7-alpha.1 || ^0.2.0-rc.1"
  },
  "dependencies": {
    "mssql": "^12.7.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "mssql",
    "sqlserver",
    "database",
    "tool"
  ],
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.7",
    "@types/mssql": "^12.3.0",
    "@types/node": "^26.0.0",
    "typescript": "^7.0.0",
    "vitest": "^4.0.0"
  }
}
